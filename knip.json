{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/daemon": {
      "project": ["src/**/*.ts"],
      "ignoreBinaries": ["mkfifo"]
    },
    "apps/cli": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@ion/daemon"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/adapter-kit": {
      "project": ["src/**/*.ts"],
      "ignoreBinaries": ["mkfifo"]
    },
    "packages/design-system": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/desktop": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "tools/lint-rules": {
      "project": ["src/**/*.js"]
    },
    "tools/health": {
      "project": ["src/**/*.js"]
    },
    "packages/adapters/*": {
      "project": ["src/**/*.ts"]
    }
  }
}
