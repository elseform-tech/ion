{
  "name": "ion",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "biome format --write .",
    "check": "biome check . && pnpm build && eslint . && turbo run typecheck test && knip && pnpm health",
    "health:dup": "jscpd apps packages tools --silent",
    "health:dead": "knip",
    "health": "pnpm health:dup && node tools/health/src/cli.js check",
    "health:update": "pnpm health:dup && node tools/health/src/cli.js update"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@ion/lint-rules": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jscpd": "^5.4.3",
    "knip": "^6.47.0",
    "turbo": "^2.11.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
