{
  "threshold": 1,
  "minLines": 6,
  "minTokens": 60,
  "reporters": ["console", "json"],
  "output": ".health/jscpd",
  "pattern": "**/*.{ts,tsx,js}",
  "ignore": [
    "**/dist/**",
    "**/node_modules/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/src-tauri/**",
    "**/*.test.js",
    "**/test/**",
    "docs/**",
    ".superpowers/**",
    ".remember/**"
  ],
  "gitignore": true,
  "absolute": false
}
