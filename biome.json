{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.turbo",
      "!docs/design",
      "!.superpowers",
      "!.remember",
      "!**/*.md",
      "!**/golden",
      "!health",
      "!.health",
      "!**/src-tauri/target",
      "!**/src-tauri/gen",
      "!.playwright-mcp",
      "!.claude",
      "!**/design-system/src/lab.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  }
}
